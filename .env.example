# =====================================================================
# ChiralGraph-RAG Environment Configuration
# =====================================================================

# --- General System Settings ---
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Graph Database Mode ---
# Options: "networkx" (in-memory zero-dependency mode) or "neo4j"
GRAPH_BACKEND=networkx

# Neo4j Settings (Required only if GRAPH_BACKEND=neo4j)
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# --- Vector Database Mode ---
# Options: "memory" (in-memory cosine similarity) or "qdrant"
VECTOR_BACKEND=memory

# Qdrant Settings (Required only if VECTOR_BACKEND=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chiral_sar_literature

# --- LLM Provider Settings ---
# Options: "mock" (offline deterministic SAR generation), "groq", or "openai"
LLM_PROVIDER=mock

# Groq Settings (Ultra-fast inference with Llama 3.3 70B)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Settings (Alternative fallback)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Cheminformatics Settings ---
ETKDG_CONFORMER_COUNT=10
FORCE_FIELD=MMFF94
MAX_CONFORMER_STRAIN_KCAL=4.0
